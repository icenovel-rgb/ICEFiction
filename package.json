    "test:style": "tsx tests/style.test.mts",
    "test:index": "tsx tests/index.test.mts",
    "test:md": "tsx tests/mdembed.test.mts",
    "test:align": "tsx tests/align.test.mts",
    "test:ai": "tsx tests/ai.test.mts",
    "test:e2e": "node tests/editor.e2e.mjs",
    "test:search:e2e": "node tests/search.e2e.mjs",
    "test:lib:e2e": "node tests/library.e2e.mjs",
    "test:image:e2e": "node tests/image.e2e.mjs",
    "test:ai:e2e": "node tests/ai.e2e.mjs",
    "dist": "electron-vite build && electron-builder --win --publish never",
    "dist:mac": "electron-vite build && electron-builder --mac --publish never",
    "test:aspect": "tsx tests/aspect.test.mts",
    "test:slash": "tsx tests/slash.test.mts",
    "test:folder:e2e": "node tests/aifolder.e2e.mjs",
    "dist:mac:release": "electron-vite build && electron-builder --mac -c.mac.notarize=true --publish never",
    "test:typing": "tsx tests/typing.test.mts",
    "test:paragap": "tsx tests/paragap.test.mts",
    "test:mark": "tsx tests/inlinemark.test.mts",
    "test:aitext": "tsx tests/aitext.test.mts",
    "test:replace": "tsx tests/replacetext.test.mts",
    "test:quotestyle": "tsx tests/quotestyle.test.mts",
    "test:update": "tsx tests/update.test.mts",
